<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="Instance.Resource.Disabled">已停用</sys:String>
    <sys:String x:Key="Instance.Resource.Error.Unavailable">檔案無法使用</sys:String>
    <sys:String x:Key="Setup.About.GitHubHome">PCL CE 社群首頁</sys:String>
